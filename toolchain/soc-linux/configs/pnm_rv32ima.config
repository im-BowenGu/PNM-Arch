# pnm_rv32ima.config — Optimised Linux kernel config for PNM orchestrator_sbc
#
# Aggressively stripped NOMMU RV32IMA configuration targeting
# minimum kernel image size for the 16 MB SRAM window.
#
# Key optimizations:
#   - Os (size-optimised) compilation
#   - No MMU, no FPU, no modules, no swap
#   - Minimal drivers: 16550 UART + NVMe block only
#   - No /proc, no /sys, no devtmpfs (single-purpose init binary)
#   - No ELF core, no coredump, no kallsyms
#   - Static initramfs, no filesystem layers

# --- Architecture ---
CONFIG_RISCV=y
CONFIG_ARCH_RV32I=y
CONFIG_NONPORTABLE=y
CONFIG_MMU=n
CONFIG_SMP=n

# --- Compiler optimisation (size over speed) ---
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# --- Compression ---
CONFIG_KERNEL_XZ=n
CONFIG_KERNEL_GZIP=n
CONFIG_HAVE_KERNEL_GZIP=n

# --- Console / UART ---
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- Block devices ---
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_NVME=y
CONFIG_BLK_DEV_RAM=y

# --- Disable all filesystem layers ---
CONFIG_PROC_FS=n
CONFIG_SYSFS=n
CONFIG_DEVTMPFS=n
CONFIG_DEVTMPFS_MOUNT=n
CONFIG_TMPFS=n
CONFIG_SHMEM=n

# --- Disable process infrastructure beyond single init ---
CONFIG_UID16=n
CONFIG_FUTEX=n
CONFIG_EPOLL=n
CONFIG_SIGNALFD=n
CONFIG_EVENTFD=n
CONFIG_TIMERFD=n
CONFIG_AIO=n
CONFIG_INOTIFY_USER=n

# --- Disable debugging / core dumps ---
CONFIG_DEBUG_INFO=n
CONFIG_MAGIC_SYSRQ=n
CONFIG_ELF_CORE=n
CONFIG_COREDUMP=n
CONFIG_KALLSYMS=n
CONFIG_PRINTK=y

# --- Disable all optional subsystems ---
CONFIG_MODULES=n
CONFIG_MODULE_UNLOAD=n
CONFIG_SWAP=n
CONFIG_CGROUPS=n
CONFIG_IPV6=n
CONFIG_WIRELESS=n
CONFIG_USB=n
CONFIG_PCI_MSI=n
CONFIG_SOUND=n
CONFIG_FB=n
CONFIG_INPUT_KEYBOARD=n
CONFIG_VT=n
CONFIG_NET=n
CONFIG_NETFILTER=n
CONFIG_PACKET=n
CONFIG_UNIX=n
CONFIG_INET=n
CONFIG_CRYPTO=n
CONFIG_CRYPTO_HASH=n
CONFIG_CRYPTO_CIPHER=n
CONFIG_USELIB=n
CONFIG_SYSCTL=n

# --- Boot command line ---
CONFIG_CMDLINE="console=ttyS0,115200 init=/init"
