# S-mode profile for the orchestrator_sbc Linux image.
#
# The chip's own profile (configs/pnm_tiny.config) is M-mode: no MMU, no
# SBI, the boot ROM jumps straight into the kernel.  Linux cannot run in
# S-mode without an MMU (the SBI spec's S-mode boot flow expects paging), so
# this overlay swaps the two choices for a host that boots through an SBI
# firmware (OpenSBI under QEMU):
#
#   make tinyconfig
#   scripts/kconfig/merge_config.sh -m .config ../configs/pnm_tiny.config
#   scripts/kconfig/merge_config.sh -m .config ../configs/pnm_tiny_sbi.config
#   make olddefconfig
#
# The init binary and the initramfs are identical in both profiles.

CONFIG_MMU=y
CONFIG_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
