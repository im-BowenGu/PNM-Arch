(librepcb_component 7c6628fc-9c7a-4543-a112-ba1867ca3869
 (name "PNM MGMT NODE HDR")
 (description "Mezzananine header for the embedded management node (an MCU or a Raspberry Pi Compute Module) that manages this node's gating ASIC and the memory behind it. Mode A: this node programs the gating weights and reads the per-token decision locally. Mode B: the header is idle and the host owns the machine over the fabric.")
 (keywords "mgmt,management,mezzanine,mcu,cm4,pnm")
 (author "PNM Project")
