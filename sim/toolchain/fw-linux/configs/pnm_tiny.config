# Minimal Linux kernel config fragment for router_sbc (RV32I, NOMMU)
#
# Merge with tinyconfig:
#   make ARCH=riscv CROSS_COMPILE=riscv64-unknown-linux-musl- tinyconfig
#   scripts/kconfig/merge_config.sh -m .config ../configs/pnm_tiny.config
#   make ARCH=riscv olddefconfig
#
# Target: 16 MB SRAM + LPDDR5 DRAM, no MMU, no FPU, no virtual memory.
# Optimised for minimum kernel size.

# --- Architecture ---
CONFIG_RISCV=y
CONFIG_64BIT=n
CONFIG_ARCH_RV32I=y
CONFIG_RISCV_ISA_RVM=n
CONFIG_RISCV_ISA_A=n
CONFIG_RISCV_ISA_F=n
CONFIG_RISCV_ISA_D=n
CONFIG_RISCV_ISA_C=n
CONFIG_RV32=n
CONFIG_MMU=n
CONFIG_SMP=n

# --- Compiler optimisation ---
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# --- Kernel ---
CONFIG_EXPERT=y
CONFIG_BUILDTIME_EXTABLE_SORT=n
CONFIG_IKCONFIG=n
CONFIG_INIT_ENV_ARG_LIMIT=1

# --- Memory ---
CONFIG_FLATMEM=y
CONFIG_ZONE_DMA=n
CONFIG_CMA=n
CONFIG_SLAB=n
CONFIG_KASAN=n

# --- Block devices (NVMe at 0xD0000000) ---
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_NVME_CLASS=y

# --- Console / UART (16550 at 0x10000000) ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=n
CONFIG_SERIAL_8250_RSA=n
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7

# --- Filesystem (for initramfs) ---
CONFIG_INITRAMFS_SOURCE=""
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=n
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_TMPFS=n
CONFIG_PROC_FS=n
CONFIG_SYSFS=n
CONFIG_DEVTMPFS=n
CONFIG_DEVTMPFS_MOUNT=n

# --- Networking (disabled) ---
CONFIG_NET=n

# --- Drivers ---
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_EARLY_FLATTREE=y
CONFIG_COMMON_CLK=y

# --- Power management (WFI support) ---
CONFIG_SUSPEND=n
CONFIG_PM=n

# --- Debugging ---
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_FUTEX=n
CONFIG_ELF_CORE=n
CONFIG_COREDUMP=n
CONFIG_KALLSYMS=n

# --- Disable everything else ---
CONFIG_MODULES=n
CONFIG_MODULE_UNLOAD=n
CONFIG_SOUND=n
CONFIG_USB=n
CONFIG_PCI=n
CONFIG_INPUT=n
CONFIG_RTC_CLASS=n
CONFIG_I2C=n
CONFIG_SPI=n
CONFIG_GPIO_CDEV=n
CONFIG_WATCHDOG=n
CONFIG_PWM=n
CONFIG_CRYPTO=n
CONFIG_SWAP=n
CONFIG_CGROUPS=n
CONFIG_SYSCTL=n
CONFIG_USELIB=n
CONFIG_AIO=n
CONFIG_EPOLL=n
CONFIG_SIGNALFD=n
CONFIG_EVENTFD=n
CONFIG_TIMERFD=n
